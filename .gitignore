# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-types/
build/
.vite/
dev-dist/
*.tsbuildinfo

# Cloudflare
.wrangler/
.dev.vars
!.dev.vars.example
.mf/

# Basemap artifacts (§14). Multi-MB binaries, regenerated by tools/basemap.sh
# and served from R2. Never in git.
*.pmtiles
*.mbtiles
tools/out/
tools/tmp/
# ...except the installed one, which is the deploy artefact (R-52b). It ships
# with the bundle, so it is in the repo on purpose — a few MB, changed when a
# location changes and not otherwise.
!apps/web/public/basemap/**/*.pmtiles

# Geodata source downloads (§14.1). PNOA orthophotos and Catastro GML are
# large, freely re-downloadable, and never a build input.
*.tif
*.tiff
*.gml
*.gpkg

# Environment
.env
.env.*
!.env.example

# svelte-check cache (--tsgo / --incremental)
.svelte-check/

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local overrides
.claude/settings.local.json
